---
const project = (lat: number, lon: number) => {
  const x = 87 * Math.cos(lat) * Math.cos(lon);
  const y = 87 * Math.sin(lat);
  const z = 87 * Math.cos(lat) * Math.sin(lon);
  return [245 + x * .92 + z * .38, 145 + y * .9 - z * .24];
};
const ring = (fixed: number, latitude: boolean) => Array.from({ length: 81 }, (_, n) => {
  const a = n / 80 * Math.PI * 2;
  const p = latitude ? project(fixed, a) : project(a, fixed);
  return `${n ? 'L' : 'M'}${p[0].toFixed(2)},${p[1].toFixed(2)}`;
}).join(' ');
