---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Introduction from '../components/Introduction.astro';
import Education from '../components/Education.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, site, url } from '../data/site';
---
<Base active="home">
  <div class="container">
    <section class="profile-hero" aria-labelledby="hero-title">
      <div class="profile-avatar"><img src={url('avatar-polar-bear.jpg')} alt="zajuka 的头像" width="160" height="160" decoding="async" fetchpriority="high"/></div>
      <h1 id="hero-title">{site.name}</h1>
      <div class="profile-socials"><a href={site.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={17}/> GitHub <Icon name="external" size={13}/></a></div>
    </section>
    <div class="profile-content">
      <Introduction/>
      <Education/>
      <section class="profile-section home-projects" aria-labelledby="projects-title">
        <header class="section-rail"><h2 id="projects-title">项目</h2><p>PROJECTS</p></header>
        <div class="section-body"><div class="home-project-list">{projects.map(project=><ProjectCard project={project}/>)}</div><div class="section-tail"><a class="small-link" href={url('projects/')}>全部项目 <Icon name="arrow" size={16}/></a></div></div>
      </section>
      <section class="profile-section home-friends" aria-labelledby="friends-title">
        <header class="section-rail"><h2 id="friends-title">友链</h2><p>CONNECTIONS</p></header>
        <div class="section-body friends-inline"><p>朋友们的网站与博客。</p><a href={url('links/')} class="button button-outline">查看友链 <Icon name="arrow" size={16}/></a></div>
      </section>
    </div>
  </div>
</Base>
