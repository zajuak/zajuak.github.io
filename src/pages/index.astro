---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import GardenArt from '../components/GardenArt.astro';
import NoteRow from '../components/NoteRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, site, url } from '../data/site';
const notes=(await getCollection('notes')).sort((a,b)=>b.data.order-a.data.order).slice(0,3);
---
<Base active="home">
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy"><p class="eyebrow hero-eyebrow"><span class="status-dot"></span> HELLO, I'M JUN KAI</p><h1 id="hero-title">保持好奇，<br/><span>让想法生长。</span><span class="hero-asterisk" aria-hidden="true">✳</span></h1><p class="hero-intro">你好，我是赵俊凯。<br/>在计算机科学的世界里探索，<br class="mobile-break"/>记录学习、思考与创造的过程。</p><div class="hero-buttons"><a class="button button-primary" href={url('notes/')}>翻开我的手记 <Icon name="arrow" size={18}/></a><a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18}/> GitHub <span>↗</span></a></div><div class="hero-footnote"><span>COMPUTER SCIENCE</span><i></i><span>A WORK IN PROGRESS</span></div></div>
      <GardenArt/>
    </section>
    <div class="intro-strip"><span class="strip-label"><span class="small-star">✳</span> 一块持续生长的数字花园</span><p>写下值得记住的事，也为尚未理解的事留一点空间。</p><span class="strip-index">EST. 2026</span></div>
    <div class="home-content">
      <section class="latest-notes" aria-labelledby="latest-title"><div class="section-heading"><div><p class="eyebrow">NOTES & THOUGHTS</p><h2 id="latest-title">最近写下的<span class="heading-dot">.</span></h2></div><a class="small-link" href={url('notes/')}>全部手记 <Icon name="arrow" size={17}/></a></div><div class="notes-list">{notes.map((note,index)=><NoteRow note={note} index={index}/>)}</div></section>
      <aside class="home-aside"><section class="currently"><div class="aside-heading"><span class="status-dot"></span><h2>此刻，在探索</h2></div><p class="aside-description">把问题拆开，把知识连起来。</p><a href={url('notes/?category=机器学习')}><span class="explore-icon">↗</span><span><strong>机器学习</strong><small>从原理走向直觉</small></span><Icon name="arrow" size={16}/></a><a href={url('notes/?category=计算机系统')}><span class="explore-icon">⌘</span><span><strong>计算机系统</strong><small>从抽象走向实现</small></span><Icon name="arrow" size={16}/></a><a href={url('projects/')}><span class="explore-icon">⌁</span><span><strong>动手构建</strong><small>让知识在实践中生根</small></span><Icon name="arrow" size={16}/></a><div class="currently-bottom">LEARN. THINK. BUILD. REPEAT.</div></section><div class="margin-note"><span class="handwritten-star">✧</span><p>不急着抵达，<br/>先认真走过每一步。</p><span class="margin-line"></span><small>A NOTE TO MYSELF</small></div></aside>
    </div>
    <section class="selected-projects" aria-labelledby="projects-title"><div class="section-heading"><div><p class="eyebrow">LEARNING BY BUILDING</p><h2 id="projects-title">把想法做出来<span class="heading-dot">.</span></h2></div><a class="small-link" href={url('projects/')}>探索项目 <Icon name="arrow" size={17}/></a></div><div class="projects-grid">{projects.map(project=><ProjectCard project={project}/>)}</div></section>
    <section class="about-strip"><span class="about-strip-mark" aria-hidden="true">↳</span><div><p class="eyebrow">A LITTLE MORE ABOUT ME</p><h2>代码之外，也有辽阔的世界。</h2><p>这里是我的思考存档，也是一个认识彼此的起点。</p></div><a href={url('about/')} class="button button-outline">认识一下 <Icon name="arrow" size={17}/></a></section>
  </div>
</Base>
