---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RepositoryList from '../components/RepositoryList.astro';
import { projects } from '../data/site';
---
<Base title="项目" active="projects">
  <div class="container page-container projects-page">
    <header class="page-heading"><h1>项目</h1></header>
    <section class="featured-tools" aria-label="在线工具">{projects.map(project => <ProjectCard project={project}/>)}</section>
    <section class="github-repositories" aria-labelledby="repositories-title"><h2 id="repositories-title" class="repository-section-title">GitHub 仓库</h2><RepositoryList/></section>
  </div>
</Base>
